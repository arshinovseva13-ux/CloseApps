{
  "name": "close-sea-battle-build",
  "version": "1.0.2",
  "private": true,
  "description": "Close Sea Battle — direct board-ID hit detection and validated fleet placement",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare.mjs",
    "build:windows": "npm run prepare:web && electron-builder --win nsis --x64",
    "build:android": "npm run prepare:web && npx cap add android && npx cap sync android && node scripts/android-icons.mjs && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "ru.closeapps.seabattle",
    "productName": "Close Sea Battle",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CloseSeaBattle-Setup-${version}.${ext}"
    }
  }
}
